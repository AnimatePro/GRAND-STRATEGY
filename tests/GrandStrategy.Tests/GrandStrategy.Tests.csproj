<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GrandStrategy.Tests</AssemblyName>
    <RootNamespace>GrandStrategy.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Чистое ядро логики компилируется напрямую (без Godot-зависимостей).
       Никаких NuGet-пакетов: собирается офлайн, запуск `dotnet run`. -->
  <ItemGroup>
    <Compile Include="../../src/SimCore/SimFormulas.cs" Link="SimFormulas.cs" />
  </ItemGroup>
</Project>
